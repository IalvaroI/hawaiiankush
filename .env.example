# Upstream API origin (use the host that serves the /ecom API path)
API_BASE_URL=https://api.example.com
# Store identifier from the Ecom API
STORE_ID=
# API key is read only by the server (dev or `npm start`); never sent to the browser
ECOM_API_KEY=
# Origin sent with API calls; must be one the key allows (Sweed answers 403 "Origin is not allowed" otherwise)
API_ORIGIN=https://shop.example.com
# Set to live only after providing API_BASE_URL and STORE_ID above
VITE_SHOP_MODE=demo
VITE_SALE_TYPE=recreational
# The store's time zone (IANA name) for pickup windows; Pacific/Honolulu when not set
VITE_STORE_TIME_ZONE=
# Google Tag Manager container ID (GTM-XXXXXXX). Optional: when set, the tag loads once; without it, shop events
# still collect in window.dataLayer and nothing is sent anywhere
VITE_GTM_ID=
# Path the storefront is served under, e.g. /maui for shop.example.com/maui
BASE_PATH=/
# Port for `npm start` (production server)
PORT=3000
# Interface to listen on. Keep 127.0.0.1 in production: only the reverse proxy should reach the app
HOST=127.0.0.1
# How long the deep health check (/healthz/deep) keeps its last Sweed answer, in milliseconds
HEALTH_CACHE_TTL_MS=15000
# Public origin of the storefront, e.g. https://shop.example.com; its host passes the CSRF check on POST/PUT/PATCH/DELETE
PUBLIC_ORIGIN=
# Session cookie is Secure unless this is false; set false only for plain-HTTP local testing
COOKIE_SECURE=true
# Set true only behind a reverse proxy that overwrites X-Forwarded-For; rate limits then key on the client IP it reports
TRUST_PROXY=false
