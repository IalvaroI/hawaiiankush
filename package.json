{
  "name": "shop-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js",
    "test:server": "node --test 'server/**/*.test.js'",
    "test:meta": "node --test shared/slug.test.js",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "check:ids": "node scripts/check-no-ids.mjs",
    "build:test": "node scripts/build-test.mjs",
    "record:fixtures": "NODE_USE_ENV_PROXY=1 node tests/mock-sweed/record.mjs",
    "test:e2e": "playwright test",
    "test": "npm run check:ids && npm run test:server && npm run test:meta && npm run test:unit && npm run build:test && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.12"
  }
}
